[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
[remote "origin"]
	url = git@github.com:luca430/compositional.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "feature/pkg"]
	remote = origin
	merge = refs/heads/feature/pkg
[branch "la/develop"]
	remote = origin
	merge = refs/heads/la/develop
